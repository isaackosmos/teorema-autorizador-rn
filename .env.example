# Copie para .env.local e preencha. Validado por src/shared/config/env.ts.
#
# Tudo com prefixo EXPO_PUBLIC_ é embutido no bundle e legível por quem
# descompactar o APK/IPA. Não coloque segredo de verdade aqui.

# Servidor central da Teorema (licença, registro de aparelho, push)
EXPO_PUBLIC_CENTRAL_API_URL=https://orion2.teorema.inf.br

# Código do sistema no licenciamento (era uAppConts.CodigoSistema)
EXPO_PUBLIC_SYSTEM_CODE=00076

# Token do servidor central — pegar com a equipe de backend
EXPO_PUBLIC_CENTRAL_API_TOKEN=

# Timeout das requisições HTTP, em milissegundos
EXPO_PUBLIC_HTTP_TIMEOUT_MS=30000
